[Unit]
Description=amberIMPROVE (wartet auf das Zeitfenster, improvt Titel für Titel)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/amberimprove/bin/amberimprove -config /etc/amberimprove/config.json run
# Stopping interrupts the current title; the file on the medium stays as it was.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=60
Nice=5

[Install]
WantedBy=multi-user.target
